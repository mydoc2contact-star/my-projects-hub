# Prisma / PostgreSQL (Supabase)
# From Supabase: Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@HOST:5432/postgres"

# Local file storage directory (URLs are stored in the database, not file bytes)
UPLOAD_DIR="public/uploads"

# App URL
# Local: http://localhost:3000
# Production: https://businessfut.netlify.app
APP_URL="http://localhost:3000"

# Supabase (optional — for Auth later)
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY stays on the server only. Never expose it in the frontend.
# SUPABASE_SERVICE_ROLE_KEY=""
